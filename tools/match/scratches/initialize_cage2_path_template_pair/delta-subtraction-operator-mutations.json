{
  "schema": 1,
  "sites": [
    {
      "name": "primary-delta-subtraction",
      "find": "            primary_samples[sample_offset].delta_dir_to_next = Vector3(\n                primary_samples[sample_offset + 1].transform.position.x\n                    - primary_samples[sample_offset].transform.position.x,\n                primary_samples[sample_offset + 1].transform.position.y\n                    - primary_samples[sample_offset].transform.position.y,\n                primary_samples[sample_offset + 1].transform.position.z\n                    - primary_samples[sample_offset].transform.position.z);",
      "replacements": [
        {
          "name": "authored-operator",
          "text": "            primary_samples[sample_offset].delta_dir_to_next =\n                primary_samples[sample_offset + 1].transform.position -\n                primary_samples[sample_offset].transform.position;"
        }
      ]
    },
    {
      "name": "secondary-delta-subtraction",
      "find": "            secondary_samples[sample_offset].delta_dir_to_next = Vector3(\n                secondary_samples[sample_offset + 1].transform.position.x\n                    - secondary_samples[sample_offset].transform.position.x,\n                secondary_samples[sample_offset + 1].transform.position.y\n                    - secondary_samples[sample_offset].transform.position.y,\n                secondary_samples[sample_offset + 1].transform.position.z\n                    - secondary_samples[sample_offset].transform.position.z);",
      "replacements": [
        {
          "name": "authored-operator",
          "text": "            secondary_samples[sample_offset].delta_dir_to_next =\n                secondary_samples[sample_offset + 1].transform.position -\n                secondary_samples[sample_offset].transform.position;"
        }
      ]
    }
  ]
}
