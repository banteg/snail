{
  "schema": 1,
  "sites": [
    {
      "name": "primary-delta-subtraction",
      "find": "        path->primary_samples[i].delta_dir_to_next = Vector3(\n            path->primary_samples[i + 1].transform.position.x -\n                path->primary_samples[i].transform.position.x,\n            path->primary_samples[i + 1].transform.position.y -\n                path->primary_samples[i].transform.position.y,\n            path->primary_samples[i + 1].transform.position.z -\n                path->primary_samples[i].transform.position.z);",
      "replacements": [
        {
          "name": "authored-operator",
          "text": "        path->primary_samples[i].delta_dir_to_next =\n            path->primary_samples[i + 1].transform.position -\n            path->primary_samples[i].transform.position;"
        }
      ]
    },
    {
      "name": "secondary-delta-subtraction",
      "find": "        path->secondary_samples[i].delta_dir_to_next = Vector3(\n            path->secondary_samples[i + 1].transform.position.x -\n                path->secondary_samples[i].transform.position.x,\n            path->secondary_samples[i + 1].transform.position.y -\n                path->secondary_samples[i].transform.position.y,\n            path->secondary_samples[i + 1].transform.position.z -\n                path->secondary_samples[i].transform.position.z);",
      "replacements": [
        {
          "name": "authored-operator",
          "text": "        path->secondary_samples[i].delta_dir_to_next =\n            path->secondary_samples[i + 1].transform.position -\n            path->secondary_samples[i].transform.position;"
        }
      ]
    }
  ]
}
