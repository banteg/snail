         }
     }
 
+    if (g_port_ultimate) {
+        // The game can spawn only one parcel per row, before the finish.
+        placed = 0;
+        for (int row = 0; row < runtime_row_count; ++row) {
+            SubRow& target = runtime_rows[row];
+            if (target.flags & SUBROW_FLAG_PARCEL_SPAWN_REQUESTED) {
+                if (row < completion_row_start && placed < required)
+                    ++placed;
+                else
+                    target.flags &= ~SUBROW_FLAG_PARCEL_SPAWN_REQUESTED;
+            }
+        }
+        // Set selection discards alternate patterns from each chosen segment.
+        // If singles ran out, fill still-vacant authored rows without another draw.
+        for (int row = 0; row < completion_row_start && placed < required; ++row) {
+            SubRow& target = runtime_rows[row];
+            SubSegment* segment = target.source_segment;
+            if ((target.flags & SUBROW_FLAG_PARCEL_SPAWN_REQUESTED) || !segment
+                || segment == &level_definition.first_segment)
+                continue;
+            int local_row = row - segment->row_base;
+            if (local_row < 0 || local_row >= segment->row_count)
+                continue;
+            AuthoredSegmentRow& authored = segment->rows[local_row];
+            Vector3 position;
+            if (authored.flags & AUTHORED_SEGMENT_ROW_FLAG_PARCEL) {
+                position = authored.local_position;
+            } else {
+                int lane = 0;
+                while (lane < SUBGAME_TRACK_LANE_COUNT) {
+                    char glyph = segment->glyph_rows[lane][local_row];
+                    if (glyph >= '0' && glyph <= '9')
+                        break;
+                    ++lane;
+                }
+                if (lane == SUBGAME_TRACK_LANE_COUNT)
+                    continue;
+                position = Vector3((float)lane - 3.5f, 0.0f, 0.0f);
+            }
+            if (target.flags & SUBROW_FLAG_MIRRORED)
+                position.x *= -1.0f;
+            position.y += 1.0f;
+            position.z = (float)row + position.z + 0.5f;
+            target.parcel_spawn_position = position;
+            target.flags |= SUBROW_FLAG_PARCEL_CANDIDATE | SUBROW_FLAG_PARCEL_SPAWN_REQUESTED;
+            ++placed;
+        }
+    }
+
     if (placed != level_definition.parcel_count) {
