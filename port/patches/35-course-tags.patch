+
+static char* first_listed_segment(char* header)
+{
+    char* next_line = Rstrnewline(header);
+    if (!g_port_ultimate || !next_line)
+        return next_line;
+
+    char* entry = header + sizeof("Segments Begin:") - 1;
+    entry += strspn(entry, " \t");
+    if (entry[0] == '/' && entry[1] == '*') {
+        char* close = strstr(entry + 2, "*/");
+        if (!close || close >= next_line)
+            return next_line;
+        entry = close + 2;
+        entry += strspn(entry, " \t");
+    }
+
+    // The recovered entry loop expects a filename, optionally followed by metadata.
+    char* extension = Rstrfind(".txt", entry);
+    return extension && extension < next_line ? entry : next_line;
+}
 
