     g_game->subgame.player.presentation.invincible_shell.list_flags |=
         BOD_FLAG_RENDER_ENABLED;
-    g_audio_backend.play_registered_sound_sample_scaled(0x30, 1.0f);
+    if (!g_port_ultimate)
