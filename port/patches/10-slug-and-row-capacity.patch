+++ b/decomp/include/slug_hazard_types.h
@@ -28,3 +28,3 @@
 enum {
-    SUB_SLUG_SLOT_CAPACITY = 8,
+    SUB_SLUG_SLOT_CAPACITY = 16, // Android's cRSubGame holds 16
 };
@@ -87,2 +87,3 @@
