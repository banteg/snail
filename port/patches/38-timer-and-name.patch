A Time Trial finish contributes the fraction of the current tick spent
reaching the line. cRTime::Add converts ticks to seconds. The Windows
caller first converts the fraction to seconds itself.

Apply the text editor's ordinary character limit to its line-break marker
as well. The high-score screens set the limit to 16.

--- a/decomp/game/SubGame/update_subgoldy.cpp
+++ b/decomp/game/SubGame/update_subgoldy.cpp
@@ -123,1 +123,2 @@
+    float tick_start_z = transform.position.z;
     cRSubGame* latch_game = game;
@@ -737,5 +738,11 @@
             if (completion_game->level_mode == 4) {
-                float remaining =
-                    (1.0f - (transform.position.z - completion_start) / velocity.z)
-                    * 0.016666668f;
-                stopwatch.Add(remaining);
+                if (g_port_ultimate) {
+                    if (tick_start_z < completion_start)
+                        stopwatch.Add((completion_start - tick_start_z) /
+                                      (transform.position.z - tick_start_z));
+                } else {
+                    float remaining =
+                        (1.0f - (transform.position.z - completion_start) / velocity.z)
+                        * 0.016666668f;
+                    stopwatch.Add(remaining);
+                }
