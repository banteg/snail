 extern bool g_port_ultimate; // shell/profile.h
 
+// Offset from the nearest point on this tick's laser segment to the asteroid.
+static Vec3 laser_contact_delta(Vec3 from_end, const Vec3& travel)
+{
+    const float length_squared = Vec3::Dot(travel, travel);
+    if (length_squared > 0.0f) {
+        const float back = -Vec3::Dot(from_end, travel) / length_squared;
+        if (back > 0.0f)
+            from_end += travel * (back < 1.0f ? back : 1.0f);
+    }
+    return from_end;
+}
